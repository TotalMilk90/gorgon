@35000 = ~Un lancer d'osselets pour faire fortune. Doublez votre mise sur un lancer gagnant.~
@35001 = ~Miser 100 pièces d'or.~
@35002 = ~Miser 250 pièces d'or.~
@35003 = ~Non, merci.~
@35004 = ~La Dame vous sourit ! Je prends vos 100 pièces d'or et vous en rends 200 !~
@35005 = ~La Dame vous sourit ! Je prends vos 250 pièces d'or et vous en rends 500 !~
@35006 = ~La Dame détourne le regard et vous perdez ! Désolé. Suivant !~
@35007 = ~Écartez-vous. Vous gênez les clients qui paient.~
